:root {
  --primary: #2459d3;
  --ink: #172033;
  --muted: #647084;
  --line: #dce2ec;
  --bg: #f3f6fb;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--ink);
}

header {
  background: linear-gradient(120deg, #1e4bb8, #3977ee);
  color: white;
  padding: 25px 5%;
}

header h1 {
  margin: 0 0 7px;
  font-size: clamp(24px, 4vw, 34px);
}

header p {
  margin: 0;
  opacity: 0.9;
}

.layout {
  display: grid;
  grid-template-columns: minmax(300px, 1fr) minmax(300px, 1fr);
  gap: 22px;
  padding: 24px 4%;
  align-items: start;
}

.panel {
  background: white;
  border: 1px solid var(--line);
  border-radius: 15px;
  padding: 20px;
  box-shadow: 0 5px 18px #23385a0a;
  min-width: 0;
}

.panel h2 {
  margin: 0 0 16px;
  font-size: 21px;
}

.section {
  border-top: 1px solid var(--line);
  padding-top: 16px;
  margin-top: 16px;
}

.section.personal {
  border-top: 0;
  padding-top: 0;
  margin-top: 0;
}

.section h3 {
  margin: 0 0 12px;
  font-size: 16px;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.field {
  margin-bottom: 12px;
  min-width: 0;
}

.field.full {
  grid-column: 1 / -1;
}

label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 6px;
  color: #354158;
}

input,
textarea,
select {
  width: 100%;
  padding: 10px 11px;
  border: 1px solid #cfd7e4;
  border-radius: 8px;
  font: inherit;
  font-size: 14px;
  background: white;
}

textarea {
  min-height: 75px;
  resize: vertical;
}

input:focus,
textarea:focus,
select:focus {
  outline: 2px solid #b9cdfd;
  border-color: var(--primary);
}

.btn {
  border: 0;
  border-radius: 8px;
  padding: 10px 14px;
  font-weight: 700;
  cursor: pointer;
  font-size: 14px;
}

.btn:hover {
  opacity: 0.88;
}

.primary {
  background: var(--primary);
  color: white;
}

.secondary {
  background: #eaf0ff;
  color: #204bb3;
}

.danger {
  background: #fff0f0;
  color: #b42318;
}

.actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.repeat-card {
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 13px;
  margin: 10px 0;
  background: #fbfcff;
}

.repeat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
  font-weight: 700;
}

.hint {
  font-size: 12px;
  color: var(--muted);
  margin-top: 5px;
}

.error {
  display: none;
  background: #fff0f0;
  color: #9b1c1c;
  padding: 10px;
  border-radius: 8px;
  margin-bottom: 12px;
  font-size: 14px;
}

.preview-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.resume {
  background: white;
  color: #202938;
  min-height: 800px;
  padding: 34px;
  box-shadow: 0 4px 22px #24365412;
  border: 1px solid var(--line);
  overflow-wrap: anywhere;
}

.resume h1 {
  margin: 0;
  color: #183f92;
  font-size: 30px;
  letter-spacing: 0.3px;
}

.resume .contact {
  font-size: 12px;
  color: #536176;
  margin: 8px 0 20px;
  line-height: 1.7;
}

.resume h2 {
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  color: #1d4eaa;
  border-bottom: 2px solid #d9e4ff;
  padding-bottom: 5px;
  margin: 22px 0 9px;
}

.resume p {
  font-size: 13px;
  line-height: 1.55;
  margin: 4px 0;
}

.resume .entry {
  margin: 10px 0;
}

.resume .entry-title {
  font-weight: 700;
  font-size: 14px;
}

.resume .entry-sub {
  font-size: 12px;
  color: #536176;
  margin: 3px 0;
}

.resume ul {
  margin: 5px 0;
  padding-left: 19px;
  font-size: 13px;
  line-height: 1.55;
}

.resume.classic {
  font-family: Georgia, serif;
}

.resume.classic h1,
.resume.classic h2 {
  color: #222;
}

.resume.modern {
  border-top: 8px solid #2459d3;
}

.resume.minimal {
  box-shadow: none;
  border: 0;
}

.empty {
  color: #7b8798;
  font-style: italic;
}

@media (max-width: 900px) {
  .layout {
    grid-template-columns: 1fr;
    padding: 15px;
  }

  .resume {
    padding: 24px;
    min-height: 600px;
  }
}

@media (max-width: 480px) {
  .grid {
    grid-template-columns: 1fr;
  }

  .field.full {
    grid-column: auto;
  }

  .panel {
    padding: 15px;
  }

  .resume {
    padding: 18px;
  }
}

@media print {
  body {
    background: white;
  }

  header,
  .form-panel,
  .preview-toolbar,
  .no-print {
    display: none !important;
  }

  .layout {
    display: block;
    padding: 0;
  }

  .preview-panel {
    border: 0;
    box-shadow: none;
    padding: 0;
  }

  .resume {
    border: 0;
    box-shadow: none;
    padding: 12mm;
    min-height: auto;
    width: 100%;
  }

  @page {
    size: A4;
    margin: 8mm;
  }
}
